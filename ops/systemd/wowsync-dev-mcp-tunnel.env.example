# Example EnvironmentFile for wowsync-dev-mcp-tunnel.service.
#
# Copy this to /etc/wowsync/dev/mcp-tunnel.env (root:root, mode 0600) and
# replace the placeholder with the real tunnel ID issued for this host. That
# path is intentionally NOT created or populated by this repo or its install
# script — only this placeholder example is committed.
#
# tunnel-client reads this value natively via the CONTROL_PLANE_TUNNEL_ID
# environment variable (equivalent to its --control-plane.tunnel-id flag), so
# no wrapper script or inlined command-line argument is needed.
CONTROL_PLANE_TUNNEL_ID=tunnel_REPLACE_WITH_REAL_TUNNEL_ID
